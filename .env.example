# ── Email 設定 ────────────────────────────────────────────────────────────────
# Gmail 範例：需先在 Google 帳戶開啟「應用程式密碼」
# 教學：https://support.google.com/accounts/answer/185833

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# 寄件帳號（Gmail 請填完整 email）
SMTP_USER=your_gmail@gmail.com

# 應用程式密碼（非 Gmail 登入密碼！）
SMTP_PASS=your_app_password_here

# 收件信箱（可以和 SMTP_USER 相同，即寄給自己）
NOTIFY_TO=your_email@example.com

# ── 監控間隔 ──────────────────────────────────────────────────────────────────
# 每隔幾秒檢查一次（預設 3600 = 1 小時）
CHECK_INTERVAL_SECONDS=3600
